name: Radon Code Metrics

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  radon_metrics:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: Install Radon
        run: pip install radon

      - name: Run Radon and generate metrics
        run: |
          OUTPUT_FILE="radon_metrics.txt"
          echo "## Radon Code Metrics Report" > "$OUTPUT_FILE"
          echo "### Raw Metrics" >> "$OUTPUT_FILE"
          radon raw . >> "$OUTPUT_FILE"
          echo "\n### Cyclomatic Complexity" >> "$OUTPUT_FILE"
          radon cc -a . >> "$OUTPUT_FILE"
          echo "\n### Halstead Metrics" >> "$OUTPUT_FILE"
          radon mi --halstead . >> "$OUTPUT_FILE"
          echo "\n### Maintainability Index" >> "$OUTPUT_FILE"
          radon mi . >> "$OUTPUT_FILE"
          cat "$OUTPUT_FILE"

      - name: Upload metrics as artifact (optional)
        uses: actions/upload-artifact@v4
        with:
          name: radon-metrics
          path: radon_metrics.txt

      - name: Create comment with metrics (optional - for PRs)
        if: github.event_name == 'pull_request'
        run: |
          METRICS=$(cat radon_metrics.txt)
          GITHUB_TOKEN="${{ secrets.GITHUB_TOKEN }}"
          ISSUE_NUMBER="${{ github.event.pull_request.number }}"
          curl -X POST \
            -H "Accept: application/vnd.github+json" \
            -H "Authorization: Bearer $GITHUB_TOKEN" \
            "https://api.github.com/repos/${{ github.repository }}/issues/$ISSUE_NUMBER/comments" \
            -d "{\"body\": \"\`\`\`text\n$METRICS\n\`\`\`\"}"
